# Supabase project settings (Project Settings > API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Base URL of this app, used to build OAuth/email redirect links.
# Use http://localhost:3000 in development.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Leave unset (or "false") while a phone number is optional. Set to "true"
# to make verification a requirement again — see src/lib/verification.ts.
# NEXT_PUBLIC_REQUIRE_PHONE_VERIFICATION=false
